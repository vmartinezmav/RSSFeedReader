@page "/"
@inject SubscriptionClient SubscriptionClient

<PageTitle>Subscriptions</PageTitle>

<section class="container py-4" aria-labelledby="subscriptions-heading">
    <h1 id="subscriptions-heading" class="h3">Subscriptions</h1>

    <div class="row g-3 align-items-end mt-1">
        <div class="col-sm-9">
            <label class="form-label" for="feed-url">Feed URL</label>
            <input id="feed-url"
                   class="form-control"
                   type="text"
                   @bind="_url" />
        </div>
        <div class="col-sm-3">
            <button id="add-subscription"
                    class="btn btn-primary w-100"
                    type="button"
                    @onclick="AddSubscriptionAsync">
                Add
            </button>
        </div>
    </div>

    @if (_errorMessage is not null)
    {
        <p class="alert alert-danger mt-3" role="alert">@_errorMessage</p>
    }

    @if (_isLoading)
    {
        <p class="mt-3" role="status">Loading subscriptions...</p>
    }
    else if (_subscriptions.Count == 0)
    {
        <p class="mt-3 text-muted">No subscriptions yet.</p>
    }
    else
    {
        <ul class="list-group mt-3" aria-live="polite">
            @foreach (var subscription in _subscriptions)
            {
                <li class="list-group-item subscription-value">@subscription</li>
            }
        </ul>
    }
</section>

@code {
    private IReadOnlyList<string> _subscriptions = Array.Empty<string>();
    private string _url = string.Empty;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _subscriptions = await SubscriptionClient.GetSubscriptionsAsync();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Unable to load subscriptions. Check that the local API is running.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AddSubscriptionAsync()
    {
        if (string.IsNullOrWhiteSpace(_url))
        {
            return;
        }

        try
        {
            var url = _url;
            await SubscriptionClient.AddSubscriptionAsync(url);
            _subscriptions = [.. _subscriptions, url];
            _url = string.Empty;
            _errorMessage = null;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Unable to add the subscription. Check that the local API is running.";
        }
    }
}